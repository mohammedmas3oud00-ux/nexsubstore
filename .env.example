# MicroeSIM API credentials (optional - enables live eSIM ordering and usage checks)
MICROESIM_ACCOUNT=
MICROESIM_SECRET=
MICROESIM_SALT=
# Set to 'test' or 'production'
MICROESIM_MODE=
# JSON map of "<productId>:<variantIndex>" to provider plan ID (production mode)
MICROESIM_PLAN_MAP={}

# Telegram Bot credentials (optional - enables order notifications and approvals)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHAT_ID=
